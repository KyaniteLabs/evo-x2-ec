# Force the EVO-X2 EC P-MODE register (0x31) to performance mode.
# NOTE: paths sanitized for publication; install the shipped
# scripts/nucbox-pmode.py at /usr/local/bin/nucbox-pmode.py, or adjust
# ExecStart to match your install.
[Unit]
Description=Force GMKtec EVO-X2 EC P-MODE to performance
After=systemd-modules-load.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/nucbox-pmode.py set performance
ExecStartPost=/usr/local/bin/nucbox-pmode.py status

[Install]
WantedBy=multi-user.target
