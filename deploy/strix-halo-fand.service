# systemd unit for nathanmarlor/strix-halo-fan-control, as deployed on
# the EVO-X2. The daemon itself is installed from the upstream repo; only the
# tuned CURVE line differs (see README "Deploy recipe and tuned curve").
#
# Upstream notice (MIT), retained per license:
#   Copyright (c) 2026 Nathan Marlor
#   https://github.com/nathanmarlor/strix-halo-fan-control
# Full MIT permission notice: THIRD-PARTY-NOTICES.md in this repo.
# This file is upstream's strix-halo-fand.service verbatim, with only
# this header and the deploy-specific comments above added.
[Unit]
Description=Strix Halo direct EC fan control
After=multi-user.target

[Service]
Type=simple
# ec_sys must be loaded with write support so the daemon can drive the EC.
ExecStartPre=-/sbin/modprobe -r ec_sys
ExecStartPre=/sbin/modprobe ec_sys write_support=1
ExecStart=/usr/local/bin/strix-halo-fand
# On stop, hand the fan back to the firmware's auto curve.
ExecStopPost=/usr/local/bin/strix-halo-fand --auto
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
